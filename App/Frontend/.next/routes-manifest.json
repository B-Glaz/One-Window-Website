{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/blog/[slug]",
      "regex": "^/blog/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/blog/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/countries/[country]",
      "regex": "^/countries/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcountry": "nxtPcountry"
      },
      "namedRegex": "^/countries/(?<nxtPcountry>[^/]+?)(?:/)?$"
    },
    {
      "page": "/for-foreign-universities/[service]",
      "regex": "^/for\\-foreign\\-universities/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPservice": "nxtPservice"
      },
      "namedRegex": "^/for\\-foreign\\-universities/(?<nxtPservice>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[slug]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
