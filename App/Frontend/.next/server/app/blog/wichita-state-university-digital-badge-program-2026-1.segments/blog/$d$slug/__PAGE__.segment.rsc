0:{"buildId":"7TV3WSDnKGdgKVGmLMU3E","data":[{"rsc":["$","$1","c",{"children":[["$","main",null,{"className":"blog-page","children":[["$","$L2",null,{}],["$","article",null,{"className":"blog-article","children":["$","div",null,{"className":"shell blog-article-shell","children":[["$","$L3",null,{"className":"blog-back-link","href":"/blog","children":[["$","$L4",null,{"iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All guides"]}],["$","p",null,{"className":"blog-tag","children":["Admissions"," · ","One Window archive"]}],["$","h1",null,{"children":"Wichita State University Digital Badge Program 2026"}],["$","p",null,{"className":"blog-article-intro","children":"In today’s competitive academic and professional environment, completing a degree is important, but it may not always be enough to help you stand out. Employers and universities increasingly value candidates who demonstrate continuous learning, practical skills, adaptability, and a genuine interest in professional development. The Wichita State University Digital Badge Program 2026 gives students, working professionals, and lifelong learners an opportunity to build focused skills through short, flexible online courses. Through the 2026 program, learners can choose from 30+ badge courses across areas such as Engineering, Business, Health Sciences, Professional Writing, Social Media, and other career-focused disciplines. Most of the courses available through this initiative are scholarship-funded, making international learning more accessible to eligible participants."}],["$","div",null,{"className":"blog-article-body","children":[["$","section","The guide",{"children":[["$","h2",null,{"children":"The guide"}],[["$","p","Whether you are preparing for university, applying for an internship, beginning your career, considering a professional transition, or simply looking to learn something new, a Wichita State University badge can become a valuable addition to your profile.",{"children":"Whether you are preparing for university, applying for an internship, beginning your career, considering a professional transition, or simply looking to learn something new, a Wichita State University badge can become a valuable addition to your profile."}]],["$","ul",null,{"children":[]}]]}],["$","section","What Is the Wichita State University Digital Badge Program?",{"children":[["$","h2",null,{"children":"What Is the Wichita State University Digital Badge Program?"}],[["$","p","A digital badge is a university-issued credential that demonstrates that a learner has successfully completed a short course and achieved specific learning outcomes.",{"children":"A digital badge is a university-issued credential that demonstrates that a learner has successfully completed a short course and achieved specific learning outcomes."}],["$","p","Unlike many informal online completion certificates, Wichita State University badges are academic short courses. They are connected to university credit and become part of the learner’s academic record. Successful completion is recorded as “BG,” meaning badge earned, on the Wichita State University transcript. The badge itself can also be shared digitally on platforms such as LinkedIn and added to a résumé or professional portfolio. (Wichita State University Catalog)",{"children":"Unlike many informal online completion certificates, Wichita State University badges are academic short courses. They are connected to university credit and become part of the learner’s academic record. Successful completion is recorded as “BG,” meaning badge earned, on the Wichita State University transcript. The badge itself can also be shared digitally on platforms such as LinkedIn and added to a résumé or professional portfolio. (Wichita State University Catalog)"}],"$L5"],"$L6"]}],"$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35"]}],"$L36"]}]}],"$L37"]}],["$L38"],"$L39"]}],"isPartial":"$@3a","staleTime":"$3b","varyParams":null},{"rsc":"$L3c","isPartial":"$@3d","staleTime":"$3b","varyParams":null},{"rsc":"$L3e","isPartial":"$@3f","staleTime":"$3b","varyParams":"$40"},{"rsc":"$L41","isPartial":"$@42","staleTime":"$3b","varyParams":"$40"},{"rsc":"$L43","isPartial":"$@44","staleTime":"$3b","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@45","rootVaryParams":null,"needsRuntimeRequest":"$@46"}
