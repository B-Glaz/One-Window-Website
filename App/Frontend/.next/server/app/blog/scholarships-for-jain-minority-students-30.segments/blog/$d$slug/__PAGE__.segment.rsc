0:{"buildId":"A2KDDaJI2Oei_cuPJJym6","data":[{"rsc":["$","$1","c",{"children":[["$","main",null,{"className":"blog-page","children":[["$","$L2",null,{}],["$","article",null,{"className":"blog-article","children":["$","div",null,{"className":"shell blog-article-shell","children":[["$","$L3",null,{"className":"blog-back-link","href":"/blog","children":[["$","$L4",null,{"iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All guides"]}],["$","p",null,{"className":"blog-tag","children":["Funding"," · ","One Window archive"]}],["$","h1",null,{"children":"SCHOLARSHIPS FOR JAIN MINORITY STUDENTS"}],["$","p",null,{"className":"blog-article-intro","children":"SCHOLARSHIPS AND EDUCATION LOAN FOR JAIN MINORITY STUDENTS! The population of Jains in our country is less than 0.4% yet they stand ahead in contributing the most to the Indian economy. Jains were given the status of a “minority religion” by the Government of India, as per Section 2(c) of the National Commission for Minorities (NCM) Act (NCM), 1992. The Jain community is one of India’s most prosperous groups. They have become a prosperous community through years of hard work and an understanding of business. However, not everyone in the community is financially secure, and this sparked the interest of several influential community members. The Jain community decided to assist students who have the academic potential to achieve greater heights but are unable to do so due to financial constraints. In addition, the ministry of minority affairs has established a few scholarships for minority students. The Jain community and the ministry of minority affairs offer the following scholarships for Jain students:"}],["$","div",null,{"className":"blog-article-body","children":[["$","section","The guide",{"children":[["$","h2",null,{"children":"The guide"}],[],["$","ul",null,{"children":[["$","li","JITO(JAIN INTERNATIONAL TRADE ORGANIZATION) EDUCATION LOAN AND SCHOLARSHIP FOR STUDYING ABROAD:",{"children":"JITO(JAIN INTERNATIONAL TRADE ORGANIZATION) EDUCATION LOAN AND SCHOLARSHIP FOR STUDYING ABROAD:"}]]}]]}],["$","section","JITO Education Loan Overview:-",{"children":[["$","h2",null,{"children":"JITO Education Loan Overview:-"}],[["$","p","The JITO education loan program is designed to provide interest subsidies on loans taken out by students from banks or NBFCs. To be eligible for the loan subsidy scheme, students must register for the program within three months of the loan’s approval date or by March 31st. JATF assists by reimbursing the interest that students paid during the previous fiscal year, which ended on March 31. Therefore, the interest subsidy pertains to the previous fiscal year and not the current one.",{"children":"The JITO education loan program is designed to provide interest subsidies on loans taken out by students from banks or NBFCs. To be eligible for the loan subsidy scheme, students must register for the program within three months of the loan’s approval date or by March 31st. JATF assists by reimbursing the interest that students paid during the previous fiscal year, which ended on March 31. Therefore, the interest subsidy pertains to the previous fiscal year and not the current one."}],["$","p","If you intend to apply for the interest subsidy under the JELP scheme, you must do so between 1 April and 31 July. Another notable feature of the interest subsidy program is that it is only available during the student’s academic career. After completion of your course, no interest subsidy will be provided on the international education loan, regardless of the loan period.",{"children":"If you intend to apply for the interest subsidy under the JELP scheme, you must do so between 1 April and 31 July. Another notable feature of the interest subsidy program is that it is only available during the student’s academic career. After completion of your course, no interest subsidy will be provided on the international education loan, regardless of the loan period."}],"$L5","$L6"],"$L7"]}],"$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf"]}],"$L10"]}]}],"$L11"]}],["$L12"],"$L13"]}],"isPartial":"$@14","staleTime":"$15","varyParams":null},{"rsc":"$L16","isPartial":"$@17","staleTime":"$15","varyParams":null},{"rsc":"$L18","isPartial":"$@19","staleTime":"$15","varyParams":"$1a"},{"rsc":"$L1b","isPartial":"$@1c","staleTime":"$15","varyParams":"$1a"},{"rsc":"$L1d","isPartial":"$@1e","staleTime":"$15","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@1f","rootVaryParams":null,"needsRuntimeRequest":"$@20"}
