14:["$","section","Maturity in handling obstacles",{"children":[["$","h2",null,{"children":"Maturity in handling obstacles"}],[["$","p","Active participation in co-curricular activities",{"children":"Active participation in co-curricular activities"}],["$","p","Short term internships",{"children":"Short term internships"}],["$","p","Decent GMAT/GRE Score",{"children":"Decent GMAT/GRE Score"}]],["$","ul",null,{"children":[]}]]}]
15:["$","section","A strong story conveyed through resume and interview (if selected)",{"children":[["$","h2",null,{"children":"A strong story conveyed through resume and interview (if selected)"}],[["$","p","[content_block id=14313 slug=zoho-form]",{"children":"[content_block id=14313 slug=zoho-form]"}]],["$","ul",null,{"children":[]}]]}]
16:["$","section","Eligibility Criteria",{"children":[["$","h2",null,{"children":"Eligibility Criteria"}],[["$","p","A student is supposed to apply through the full-time MBA Program admission route itself, but for availing of the silver scholar’s program he/she has to take care of the following points:",{"children":"A student is supposed to apply through the full-time MBA Program admission route itself, but for availing of the silver scholar’s program he/she has to take care of the following points:"}],["$","p","You are only eligible to apply if you are in the third year of your undergraduate course.",{"children":"You are only eligible to apply if you are in the third year of your undergraduate course."}]],["$","ul",null,{"children":[]}]]}]
17:["$","section","You must provide two letters of recommendation: one from an academic instructor/ faculty member for your performance  and",{"children":[["$","h2",null,{"children":"You must provide two letters of recommendation: one from an academic instructor/ faculty member for your performance  and"}],[["$","p","Another from an employer (in case of part-time job/ internship) or an organization where you actively volunteered in/ performed any extra-curricular activity.",{"children":"Another from an employer (in case of part-time job/ internship) or an organization where you actively volunteered in/ performed any extra-curricular activity."}],["$","p","Application form",{"children":"Application form"}],["$","p","Things to include in your application:",{"children":"Things to include in your application:"}]],["$","ul",null,{"children":[]}]]}]
18:["$","section","Official transcripts of your undergraduate course-two certified copies",{"children":[["$","h2",null,{"children":"Official transcripts of your undergraduate course-two certified copies"}],[["$","p","Copies of previously secured degrees, if any.",{"children":"Copies of previously secured degrees, if any."}],["$","p","Curriculum Vitae",{"children":"Curriculum Vitae"}],["$","p","GMAT/GRE Score",{"children":"GMAT/GRE Score"}],["$","p","TOEFL/IELTS Results",{"children":"TOEFL/IELTS Results"}],["$","p","Two letters of recommendations",{"children":"Two letters of recommendations"}]],["$","ul",null,{"children":[]}]]}]
19:["$","section","One creatively drafted main essay",{"children":[["$","h2",null,{"children":"One creatively drafted main essay"}],[["$","p","For guidance on the application filing process and help in drafting the essay, reach out to one of our experts at (hyperlink)",{"children":"For guidance on the application filing process and help in drafting the essay, reach out to one of our experts at (hyperlink)"}],["$","p","Selection Process",{"children":"Selection Process"}],["$","p","Best applications are picked after a thorough analysis of the candidate’s profile. The selected candidates are called for an interview which can be in-person or through video-calling means as chosen by the applicant.",{"children":"Best applications are picked after a thorough analysis of the candidate’s profile. The selected candidates are called for an interview which can be in-person or through video-calling means as chosen by the applicant."}],["$","p","The interview majorly focuses on the ambitions, interests, and skills of the candidate.",{"children":"The interview majorly focuses on the ambitions, interests, and skills of the candidate."}],["$","p","Selected candidates receive an offer letter from the Yale University Office.",{"children":"Selected candidates receive an offer letter from the Yale University Office."}]],["$","ul",null,{"children":[]}]]}]
1a:["$","section","Yale Silver Scholars Program- Structure",{"children":[["$","h2",null,{"children":"Yale Silver Scholars Program- Structure"}],[["$","p","The program admits you to a 3 year MBA course. We have compiled the details separately for each year, mentioned below:",{"children":"The program admits you to a 3 year MBA course. We have compiled the details separately for each year, mentioned below:"}],["$","p","Year One",{"children":"Year One"}],["$","p","The candidates in the first year of the program share the classroom with fellow undergraduates coming from different educational as well as cultural backgrounds.",{"children":"The candidates in the first year of the program share the classroom with fellow undergraduates coming from different educational as well as cultural backgrounds."}],["$","p","They are introduced to a very unconventional study syllabus and are encouraged to develop efficient management skills.",{"children":"They are introduced to a very unconventional study syllabus and are encouraged to develop efficient management skills."}],["$","p","They are offered to learn a palette of core courses from prominent faculties.",{"children":"They are offered to learn a palette of core courses from prominent faculties."}],["$","p","These courses are:",{"children":"These courses are:"}],["$","p","Introduction to Negotiation",{"children":"Introduction to Negotiation"}],["$","p","Power and Politics",{"children":"Power and Politics"}],["$","p","Managing Groups and Teams",{"children":"Managing Groups and Teams"}],["$","p","Global Virtual Teams",{"children":"Global Virtual Teams"}],["$","p","Basics of Accounting",{"children":"Basics of Accounting"}]],["$","ul",null,{"children":[]}]]}]
1b:["$","section","Modeling Managerial Decisions",{"children":[["$","h2",null,{"children":"Modeling Managerial Decisions"}],[["$","p","Probability Modelling and Statistics",{"children":"Probability Modelling and Statistics"}],["$","p","Basics of Economics",{"children":"Basics of Economics"}],["$","p","Year Two",{"children":"Year Two"}],["$","p","With the theoretical knowledge gained in the first year of the program, candidates are offered a full-time internship where they apply the same to practice real-life scenarios. This helps them shape their skills to secure a successful career in the future. These internships are provided at various reputed organizations, some of which are Pfizer, Boston Consultancy Group, Coca Cola,",{"children":"With the theoretical knowledge gained in the first year of the program, candidates are offered a full-time internship where they apply the same to practice real-life scenarios. This helps them shape their skills to secure a successful career in the future. These internships are provided at various reputed organizations, some of which are Pfizer, Boston Consultancy Group, Coca Cola,"}],["$","p","Motorola and CARE.",{"children":"Motorola and CARE."}],["$","p","Year Three",{"children":"Year Three"}],["$","p","Post the second-year internship, the third-year MBA program commences wherein the students choose their electives at Yale as well as other global universities for Advanced Management in areas that complement the career path they have chosen so far.",{"children":"Post the second-year internship, the third-year MBA program commences wherein the students choose their electives at Yale as well as other global universities for Advanced Management in areas that complement the career path they have chosen so far."}],["$","p","All students must meet at least one of the following Global Studies Requirements which are:",{"children":"All students must meet at least one of the following Global Studies Requirements which are:"}],["$","p","Taking a course in International Experience, by spending ten days in a location situated overseas to understand the global economy",{"children":"Taking a course in International Experience, by spending ten days in a location situated overseas to understand the global economy"}]],["$","ul",null,{"children":[]}]]}]
1c:["$","section","a mini-course for Advanced Management hosted by one of the member schools in the Global Network",{"children":[["$","h2",null,{"children":"a mini-course for Advanced Management hosted by one of the member schools in the Global Network"}],[["$","p","Completing an online GNC (Global Network Course) a virtual course to look at a cross-national business problem in which students work with a global team",{"children":"Completing an online GNC (Global Network Course) a virtual course to look at a cross-national business problem in which students work with a global team"}],["$","p","Selecting other approved electives that involve international travel and study",{"children":"Selecting other approved electives that involve international travel and study"}]],["$","ul",null,{"children":[]}]]}]
1d:["$","section","Access to career advisors and their guidance in the building profession",{"children":[["$","h2",null,{"children":"Access to career advisors and their guidance in the building profession"}],[["$","p","Opportunity to network with talented people",{"children":"Opportunity to network with talented people"}],["$","p","Our Word",{"children":"Our Word"}],["$","p","There are many other benefits to this program and ways you can easily apply for the same. We would love to help you out with your doubts and queries about the same. Book an appointment with one of our",{"children":"There are many other benefits to this program and ways you can easily apply for the same. We would love to help you out with your doubts and queries about the same. Book an appointment with one of our"}],["$","p","expert consultants here",{"children":"expert consultants here"}],["$","p","to know more!",{"children":"to know more!"}]],["$","ul",null,{"children":[]}]]}]
