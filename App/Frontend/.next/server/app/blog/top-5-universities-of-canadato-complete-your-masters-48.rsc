15:["$","section","University of Toronto",{"children":[["$","h2",null,{"children":"University of Toronto"}],[["$","p","Since its founding in 1827, the University of Toronto has grown to become Canada’s leading educational institution. It is a historic structure with over 100 years of discovery and knowledge creation. With a strong desire to invent and innovate, it is renowned to be one of the top research-intensive universities in the world. Also known as UToronto, this public research university is a great place for intensive learning. It is a global leader in research and education, with a substantial presence in both Canada and the rest of the world. It is the only Canadian university to be ranked among the top 20 universities in the World University Rankings 2022.",{"children":"Since its founding in 1827, the University of Toronto has grown to become Canada’s leading educational institution. It is a historic structure with over 100 years of discovery and knowledge creation. With a strong desire to invent and innovate, it is renowned to be one of the top research-intensive universities in the world. Also known as UToronto, this public research university is a great place for intensive learning. It is a global leader in research and education, with a substantial presence in both Canada and the rest of the world. It is the only Canadian university to be ranked among the top 20 universities in the World University Rankings 2022."}]],["$","ul",null,{"children":[]}]]}]
16:["$","section","[content_block id=14313 slug=zoho-form]",{"children":[["$","h2",null,{"children":"[content_block id=14313 slug=zoho-form]"}],[["$","p","The University of British Columbia (UBC) is a world-class teaching, learning, and research institution. It has continuously been placed among the top 20 public institutions in the world. As one of the world’s best universities, they have a critical role to play in making the world a better place. It implies that UBC offers a diverse range of job options: it’s not your usual workday. With such diversity, the people must also be distinct. It isn’t a cookie-cutter atmosphere where anything goes. People with a vision, a spark, tenacity, and enthusiasm are the ones that survive.",{"children":"The University of British Columbia (UBC) is a world-class teaching, learning, and research institution. It has continuously been placed among the top 20 public institutions in the world. As one of the world’s best universities, they have a critical role to play in making the world a better place. It implies that UBC offers a diverse range of job options: it’s not your usual workday. With such diversity, the people must also be distinct. It isn’t a cookie-cutter atmosphere where anything goes. People with a vision, a spark, tenacity, and enthusiasm are the ones that survive."}],["$","p","McGill University is one of Canada’s most well-known colleges and universities, as well as one of the world’s most prestigious universities. Their student body is the most internationally varied of any research-intensive university in Canada, with students hailing from over 150 countries.",{"children":"McGill University is one of Canada’s most well-known colleges and universities, as well as one of the world’s most prestigious universities. Their student body is the most internationally varied of any research-intensive university in Canada, with students hailing from over 150 countries."}],["$","p","This University is dedicated to recognizing and nurturing bright minds since its founding in 1887. With ground-breaking approaches to teaching and learning, as well as world-class interdisciplinary research. McMaster University, which is now ranked #4 in Canada, is one of the Canadian universities to routinely rank among the top 100 universities in the world.",{"children":"This University is dedicated to recognizing and nurturing bright minds since its founding in 1887. With ground-breaking approaches to teaching and learning, as well as world-class interdisciplinary research. McMaster University, which is now ranked #4 in Canada, is one of the Canadian universities to routinely rank among the top 100 universities in the world."}],["$","p","5",{"children":"5"}],["$","p",".",{"children":"."}]],["$","ul",null,{"children":[["$","li","The University of British Columbia, Vancouver",{"children":"The University of British Columbia, Vancouver"}],["$","li","McGill University, Montréal",{"children":"McGill University, Montréal"}],["$","li","McMaster University, Hamilton",{"children":"McMaster University, Hamilton"}]]}]]}]
17:["$","section","University of Alberta, Edmonton",{"children":[["$","h2",null,{"children":"University of Alberta, Edmonton"}],[["$","p","The University of Alberta in Edmonton is a leading teaching and research university in Canada. With a worldwide reputation for excellence in the humanities, sciences, creative arts, business, engineering, and health sciences. Its graduates have the highest employment rate in Canada and the globe. Thanks to a variety of internship and work experience programs, as well as job shadowing and career mentorship options.",{"children":"The University of Alberta in Edmonton is a leading teaching and research university in Canada. With a worldwide reputation for excellence in the humanities, sciences, creative arts, business, engineering, and health sciences. Its graduates have the highest employment rate in Canada and the globe. Thanks to a variety of internship and work experience programs, as well as job shadowing and career mentorship options."}],["$","p","These Canadian universities have been ranked based on their overall rankings in the",{"children":"These Canadian universities have been ranked based on their overall rankings in the"}]],["$","ul",null,{"children":[]}]]}]
18:["$","section","Best Global Universities list",{"children":[["$","h2",null,{"children":"Best Global Universities list"}],[["$","p",". Rating was done by members of the academic community from around the world & within North America, based on their research performance. These are Canada’s top international universities.",{"children":". Rating was done by members of the academic community from around the world & within North America, based on their research performance. These are Canada’s top international universities."}],["$","p","To know more about the admission process, scholarships and unlock the world of global education and a better future,",{"children":"To know more about the admission process, scholarships and unlock the world of global education and a better future,"}]],["$","ul",null,{"children":[]}]]}]
19:["$","section","Get in touch with One Window",{"children":[["$","h2",null,{"children":"Get in touch with One Window"}],[["$","p",". Our counsellors will help you in each step and pave the way to get into your dream university.",{"children":". Our counsellors will help you in each step and pave the way to get into your dream university."}]],["$","ul",null,{"children":[]}]]}]
