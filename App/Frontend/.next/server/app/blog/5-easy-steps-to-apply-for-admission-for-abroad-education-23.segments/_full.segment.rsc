19:["$","section","3rd Step: Creating an Application",{"children":[["$","h2",null,{"children":"3rd Step: Creating an Application"}],[["$","p","The next step is creating a suitable application to universities that you have shortlisted.",{"children":"The next step is creating a suitable application to universities that you have shortlisted."}],["$","p","You have to submit various documents along with your application form.",{"children":"You have to submit various documents along with your application form."}],["$","p","The documents such as:",{"children":"The documents such as:"}],["$","p","your academic transcripts",{"children":"your academic transcripts"}],["$","p","Test scores,",{"children":"Test scores,"}],["$","p","CV or resume,",{"children":"CV or resume,"}],["$","p","Essays and",{"children":"Essays and"}]],["$","ul",null,{"children":[]}]]}]
1a:["$","section","Portfolio (if applicable)",{"children":[["$","h2",null,{"children":"Portfolio (if applicable)"}],[["$","p","Are needed to be submitted along with your application.",{"children":"Are needed to be submitted along with your application."}],["$","p","The documents may vary depending on the country, university and course you are applying for, so make sure you check the specific requirements on the university’s website or take updates with your counsellor.",{"children":"The documents may vary depending on the country, university and course you are applying for, so make sure you check the specific requirements on the university’s website or take updates with your counsellor."}],["$","p","*Please note that You will also need to pay an application fee for each university you apply to. This may also vary on each and every university you choose to apply.",{"children":"*Please note that You will also need to pay an application fee for each university you apply to. This may also vary on each and every university you choose to apply."}]],["$","ul",null,{"children":[]}]]}]
1b:["$","section","4th Step: Wait for the Reply",{"children":[["$","h2",null,{"children":"4th Step: Wait for the Reply"}],[["$","p","After submitting your application, you will have to wait for the university’s response. This may take from a few weeks to a few months depending on the university and the intake season.",{"children":"After submitting your application, you will have to wait for the university’s response. This may take from a few weeks to a few months depending on the university and the intake season."}],["$","p","If your application is successful, you will receive a letter of offer and an acceptance form from the university.",{"children":"If your application is successful, you will receive a letter of offer and an acceptance form from the university."}],["$","p","You need to read the offer letter carefully and check for conditions that may apply,",{"children":"You need to read the offer letter carefully and check for conditions that may apply,"}],["$","p","Such as",{"children":"Such as"}],["$","p","Paying a deposit or",{"children":"Paying a deposit or"}],["$","p","Meeting certain academic criteria.",{"children":"Meeting certain academic criteria."}],["$","p","You will also need to sign and return the acceptance form to confirm your enrolment.",{"children":"You will also need to sign and return the acceptance form to confirm your enrolment."}]],["$","ul",null,{"children":[]}]]}]
1c:["$","section","5th Step: Apply for your VISA",{"children":[["$","h2",null,{"children":"5th Step: Apply for your VISA"}],[["$","p","The final step is to apply for your student visa. This is a very important and sensitive part of your study abroad journey.",{"children":"The final step is to apply for your student visa. This is a very important and sensitive part of your study abroad journey."}],["$","p","As it determines whether you can enter and stay in your chosen country legally. You will need to follow the visa application process and requirements of the country you are going to study in.",{"children":"As it determines whether you can enter and stay in your chosen country legally. You will need to follow the visa application process and requirements of the country you are going to study in."}],["$","p","You will also need to provide various documents such as:",{"children":"You will also need to provide various documents such as:"}],["$","p","Your passport",{"children":"Your passport"}],["$","p","Offer letter",{"children":"Offer letter"}],["$","p","Financial proof",{"children":"Financial proof"}],["$","p","Health insurance and",{"children":"Health insurance and"}],["$","p","Medical tests.",{"children":"Medical tests."}],["$","p","Our counsellor can assist you with preparing and submitting your visa application and advise you on how to deal with any issues that may arise.",{"children":"Our counsellor can assist you with preparing and submitting your visa application and advise you on how to deal with any issues that may arise."}],["$","p","In conclusion of this blog, we believe to see an opportunity of how Studying abroad can be a life-changing experience that can open up many opportunities for your personal and professional growth. If you are ready to take the next step towards your study abroad dream, contact us today and we will help you make it happen!",{"children":"In conclusion of this blog, we believe to see an opportunity of how Studying abroad can be a life-changing experience that can open up many opportunities for your personal and professional growth. If you are ready to take the next step towards your study abroad dream, contact us today and we will help you make it happen!"}],["$","p","For Further information on studying abroad, please visit our website here or fill out this form to get in touch with one of our counsellors.",{"children":"For Further information on studying abroad, please visit our website here or fill out this form to get in touch with one of our counsellors."}],["$","p","We look forward to hearing from you soon!",{"children":"We look forward to hearing from you soon!"}],["$","p","HAPPY STUDYING!",{"children":"HAPPY STUDYING!"}]],["$","ul",null,{"children":[]}]]}]
