14:["$","section","Transparency in Processing",{"children":[["$","h2",null,{"children":"Transparency in Processing"}],[["$","p","– As a parent, you might be concerned about who your child seeks to avail an education loan from. HDFC Credilais one of the most trusted entities operating within the realm of financial services. You need not worry about getting a loan from HDFC Credila, as here, the entire process is transparent and made clear from the get-go.",{"children":"– As a parent, you might be concerned about who your child seeks to avail an education loan from. HDFC Credilais one of the most trusted entities operating within the realm of financial services. You need not worry about getting a loan from HDFC Credila, as here, the entire process is transparent and made clear from the get-go."}]],["$","ul",null,{"children":[]}]]}]
15:["$","section","Ease of Application",{"children":[["$","h2",null,{"children":"Ease of Application"}],[["$","p","– Applying for an education loan has never been easier as you can submit an online application*. Furthermore, you can arrange to have a loan specialist visit your home to discuss the finer details of your loan.",{"children":"– Applying for an education loan has never been easier as you can submit an online application*. Furthermore, you can arrange to have a loan specialist visit your home to discuss the finer details of your loan."}]],["$","ul",null,{"children":[]}]]}]
16:["$","section","Sense of Financial Responsibility",{"children":[["$","h2",null,{"children":"Sense of Financial Responsibility"}],[["$","p","– By taking on this loan, students develop a responsible attitude towards their finances, which leaves parents to focus on directing their hard-earned savings towards their own retirement along with planning for any contingencies.",{"children":"– By taking on this loan, students develop a responsible attitude towards their finances, which leaves parents to focus on directing their hard-earned savings towards their own retirement along with planning for any contingencies."}],["$","p","Conclusion",{"children":"Conclusion"}],["$","p","A student loan can enable you to attend the",{"children":"A student loan can enable you to attend the"}],["$","p","university of your dreams!",{"children":"university of your dreams!"}],["$","p","and to start your career after you graduate. Have faith and do not be afraid to give yourself the opportunity that education loans provide you with. Offering a range of attractive features and benefits, a loan from",{"children":"and to start your career after you graduate. Have faith and do not be afraid to give yourself the opportunity that education loans provide you with. Offering a range of attractive features and benefits, a loan from"}],["$","p","HDFC Credila",{"children":"HDFC Credila"}],["$","p","is an investment in your future!",{"children":"is an investment in your future!"}],["$","p","*T&C apply",{"children":"*T&C apply"}]],["$","ul",null,{"children":[]}]]}]
