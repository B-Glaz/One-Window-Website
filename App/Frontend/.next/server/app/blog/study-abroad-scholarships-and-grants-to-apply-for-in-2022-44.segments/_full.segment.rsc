4:["$","main",null,{"className":"blog-page","children":[["$","$Le",null,{}],["$","article",null,{"className":"blog-article","children":["$","div",null,{"className":"shell blog-article-shell","children":[["$","$Lf",null,{"className":"blog-back-link","href":"/blog","children":[["$","$L10",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All guides"]}],["$","p",null,{"className":"blog-tag","children":["Funding"," · ","One Window archive"]}],["$","h1",null,{"children":"Study Abroad Scholarships and Grants to Apply for in 2022"}],["$","p",null,{"className":"blog-article-intro","children":"With the COVID-19 restrictions finally loosening, a large number of countries have opened their doors again for people to learn, seek career opportunities and grow in a plethora of fields. Students aspiring to build a career abroad find it very difficult to build one with the high costs of living, hefty tuition fees of world-known universities, and travel expenditures. But you need not worry! We are here with a list of Scholarships and Grants by various reputed universities and colleges for the year 2022-2023 that you can apply for and avail benefits that make it easier for you to fill the canvas of your dreams with flying colors of success. Listed below are some of the scholarships that are most beneficial and convenient to apply for Indian students."}],["$","div",null,{"className":"blog-article-body","children":[["$","section","The Inlaks Shivdashani Scholarships",{"children":[["$","h2",null,{"children":"The Inlaks Shivdashani Scholarships"}],[["$","p","The top universities in the US, Europe, and the UK grant the Inlaks Shivdashani Scholarships.",{"children":"The top universities in the US, Europe, and the UK grant the Inlaks Shivdashani Scholarships."}],["$","p","These scholarships are especially granted to the young minds of India aspiring to study for a Master’s degree or a full-time doctorate program.",{"children":"These scholarships are especially granted to the young minds of India aspiring to study for a Master’s degree or a full-time doctorate program."}],["$","p","Required qualifications:",{"children":"Required qualifications:"}],["$","p","Mathematics, Environment, and similar subjects:",{"children":"Mathematics, Environment, and similar subjects:"}]],["$","ul",null,{"children":[]}]]}],["$","section","minimum 70 percentile/ 7.2 CGPA or GPA 2.8 from a recognized Indian university",{"children":[["$","h2",null,{"children":"minimum 70 percentile/ 7.2 CGPA or GPA 2.8 from a recognized Indian university"}],[["$","p","Humanities, fine arts, social science, law, architecture:",{"children":"Humanities, fine arts, social science, law, architecture:"}],["$","p","minimum 65 percentile/ 6.8 CGPA/GPA 2.6 from a recognized Indian university",{"children":"minimum 65 percentile/ 6.8 CGPA/GPA 2.6 from a recognized Indian university"}],["$","p","Age limit:",{"children":"Age limit:"}],["$","p","maximum 30 years",{"children":"maximum 30 years"}],["$","p","Minimum duration of residence in India: 6 months",{"children":"Minimum duration of residence in India: 6 months"}],["$","p","Aids provided:",{"children":"Aids provided:"}],["$","p","100% tuition fee, health allowance, one-way travel allowance.",{"children":"100% tuition fee, health allowance, one-way travel allowance."}],["$","p","Living expenditure",{"children":"Living expenditure"}],["$","p","Maximum funding : USD 1.00,000.",{"children":"Maximum funding : USD 1.00,000."}],["$","p","To know more:",{"children":"To know more:"}],["$","p","https://www.inlaksfoundation.org/scholarships/how-to-apply/",{"children":"https://www.inlaksfoundation.org/scholarships/how-to-apply/"}]],"$L11"]}],"$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}],"$L21"]}]}],"$L22"]}]
