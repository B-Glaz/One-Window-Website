1b:["$","section","Erasmus Mundus Scholarships",{"children":[["$","h2",null,{"children":"Erasmus Mundus Scholarships"}],[["$","p","7 world-class and internationally renowned universities, namely the University of Glasgow, University of Barcelona, Uppsala University, Erasmus University Rotterdam, University of Gottingen, Universidad de Los Andes, and Kyoto University offer to teach an International Master’s Degree to students from all over the world.",{"children":"7 world-class and internationally renowned universities, namely the University of Glasgow, University of Barcelona, Uppsala University, Erasmus University Rotterdam, University of Gottingen, Universidad de Los Andes, and Kyoto University offer to teach an International Master’s Degree to students from all over the world."}],["$","p","The Course is Global Markets, Local Creativities (ERASMUS MUNDUS INTERNATIONAL MASTER) IntM.",{"children":"The Course is Global Markets, Local Creativities (ERASMUS MUNDUS INTERNATIONAL MASTER) IntM."}],["$","p","Required qualifications:",{"children":"Required qualifications:"}]],["$","ul",null,{"children":[]}]]}]
