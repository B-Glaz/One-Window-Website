15:["$","section","Commonwealth Scholarships",{"children":[["$","h2",null,{"children":"Commonwealth Scholarships"}],[["$","p","Commonwealth Ph.D. Scholarships, Commonwealth Split-site Scholarships, Commonwealth Shared Scholarships, Commonwealth Master’s Scholarships, Commonwealth Distance Learning Scholarships, and Commonwealth Medical and Professional Fellowships are some of the Commonwealth Scholarships offered to students of Commonwealth Countries to study in the UK.",{"children":"Commonwealth Ph.D. Scholarships, Commonwealth Split-site Scholarships, Commonwealth Shared Scholarships, Commonwealth Master’s Scholarships, Commonwealth Distance Learning Scholarships, and Commonwealth Medical and Professional Fellowships are some of the Commonwealth Scholarships offered to students of Commonwealth Countries to study in the UK."}],["$","p","Required qualifications:",{"children":"Required qualifications:"}],["$","p","The student should be a citizen/ permanent resident of Commonwealth Country.",{"children":"The student should be a citizen/ permanent resident of Commonwealth Country."}],["$","p","Undergraduate degree of upper second class.",{"children":"Undergraduate degree of upper second class."}],["$","p","Appropriate Master’s Degree for students applying for PhD",{"children":"Appropriate Master’s Degree for students applying for PhD"}],["$","p","Aids provided:",{"children":"Aids provided:"}],["$","p","100% tuition fee, two-way travel allowance.",{"children":"100% tuition fee, two-way travel allowance."}],["$","p","Living expenditure",{"children":"Living expenditure"}]],["$","ul",null,{"children":[]}]]}]
16:["$","section","Fulbright Scholarship",{"children":[["$","h2",null,{"children":"Fulbright Scholarship"}],[["$","p","Since 1946, foreign Students from around 155 Countries are being provided with Fulbright Scholarships to study in United States Universities and Academic Institutions.",{"children":"Since 1946, foreign Students from around 155 Countries are being provided with Fulbright Scholarships to study in United States Universities and Academic Institutions."}],["$","p","Scholarships are offered for Masters and PhDs in courses from all fields including interdisciplinary courses for varying periods depending on the selected program.",{"children":"Scholarships are offered for Masters and PhDs in courses from all fields including interdisciplinary courses for varying periods depending on the selected program."}],["$","p","Required qualifications:",{"children":"Required qualifications:"}],["$","p","US Bachelor’s Degree or equivalent (minimum 55% marks).",{"children":"US Bachelor’s Degree or equivalent (minimum 55% marks)."}],["$","p","The student should demonstrate leadership skills.",{"children":"The student should demonstrate leadership skills."}],["$","p","Highly motivated.",{"children":"Highly motivated."}],["$","p","Aids provided:",{"children":"Aids provided:"}],["$","p","100% tuition fee.",{"children":"100% tuition fee."}],["$","p","Two-way travel allowance for economy class air travel.",{"children":"Two-way travel allowance for economy class air travel."}],["$","p","Living expenditure.",{"children":"Living expenditure."}],["$","p","Accident and sickness coverage.",{"children":"Accident and sickness coverage."}],["$","p","J-1 Visa Support.",{"children":"J-1 Visa Support."}]],["$","ul",null,{"children":[]}]]}]
