12:["$","section","GREAT Scholarships India",{"children":[["$","h2",null,{"children":"GREAT Scholarships India"}],[["$","p","To encourage the world to visit, study and do business with the UK, the government has introduced the GREAT Britain Campaign to stimulate jobs and growth.",{"children":"To encourage the world to visit, study and do business with the UK, the government has introduced the GREAT Britain Campaign to stimulate jobs and growth."}],["$","p","The campaign also funds 20 scholarships for Indian students of the same name along with the British Council and participating UK Universities.",{"children":"The campaign also funds 20 scholarships for Indian students of the same name along with the British Council and participating UK Universities."}],["$","p","Required qualifications:",{"children":"Required qualifications:"}],["$","p","Students should be a citizen of India.",{"children":"Students should be a citizen of India."}]],["$","ul",null,{"children":[]}]]}]
