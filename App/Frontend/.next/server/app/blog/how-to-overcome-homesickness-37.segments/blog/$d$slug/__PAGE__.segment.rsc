0:{"buildId":"7TV3WSDnKGdgKVGmLMU3E","data":[{"rsc":["$","$1","c",{"children":[["$","main",null,{"className":"blog-page","children":[["$","$L2",null,{}],["$","article",null,{"className":"blog-article","children":["$","div",null,{"className":"shell blog-article-shell","children":[["$","$L3",null,{"className":"blog-back-link","href":"/blog","children":[["$","$L4",null,{"iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}]," All guides"]}],["$","p",null,{"className":"blog-tag","children":["Life abroad"," · ","One Window archive"]}],["$","h1",null,{"children":"How To Overcome Homesickness?"}],["$","p",null,{"className":"blog-article-intro","children":"$5"}],["$","div",null,{"className":"blog-article-body","children":[["$","section","i. Feeling sad , anxious , nervous, angry",{"children":[["$","h2",null,{"children":"i. Feeling sad , anxious , nervous, angry"}],[["$","p","ii. Developing a feeling of insecurity , getting panic",{"children":"ii. Developing a feeling of insecurity , getting panic"}],["$","p","iii. Headaches",{"children":"iii. Headaches"}],["$","p","iv. Having a disturbed sleep pattern",{"children":"iv. Having a disturbed sleep pattern"}]],["$","ul",null,{"children":[]}]]}],["$","section","Top 6 ways to help you overcome Homesickness",{"children":[["$","h2",null,{"children":"Top 6 ways to help you overcome Homesickness"}],[["$","p","“Patience is bitter, but it’s fruit is sweet.”- Aristotle quoted this very small yet deep quote about having patience is one of the most positive virtues in achieving anything in life. Instead of stressing over things which are not practically possible . Try meditation and mindfulness to keep yourself calm and patient . because every process takes time, the process maybe slow but its worth the wait.",{"children":"“Patience is bitter, but it’s fruit is sweet.”- Aristotle quoted this very small yet deep quote about having patience is one of the most positive virtues in achieving anything in life. Instead of stressing over things which are not practically possible . Try meditation and mindfulness to keep yourself calm and patient . because every process takes time, the process maybe slow but its worth the wait."}],["$","p","Talking about your feelings could be difficult but it isn’t impossible. Talking to your loved one’s could make the distance feel shorter. Videocall , text, audio call them it would help you feel less anxious but talking all the time or everyday could take you back again to the starting point and would keep you off from making new friends. You need your old loved one’s but you also need to start adjusting with your new surroundings. Remember the mantra 3E’s ‘evolve’ , ‘experience’ , ‘explore’ . practice these 3E’s in your life for better living.",{"children":"Talking about your feelings could be difficult but it isn’t impossible. Talking to your loved one’s could make the distance feel shorter. Videocall , text, audio call them it would help you feel less anxious but talking all the time or everyday could take you back again to the starting point and would keep you off from making new friends. You need your old loved one’s but you also need to start adjusting with your new surroundings. Remember the mantra 3E’s ‘evolve’ , ‘experience’ , ‘explore’ . practice these 3E’s in your life for better living."}],"$L6","$L7"],"$L8"]}],"$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf"]}],"$L10"]}]}],"$L11"]}],["$L12"],"$L13"]}],"isPartial":"$@14","staleTime":"$15","varyParams":null},{"rsc":"$L16","isPartial":"$@17","staleTime":"$15","varyParams":null},{"rsc":"$L18","isPartial":"$@19","staleTime":"$15","varyParams":"$1a"},{"rsc":"$L1b","isPartial":"$@1c","staleTime":"$15","varyParams":"$1a"},{"rsc":"$L1d","isPartial":"$@1e","staleTime":"$15","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@1f","rootVaryParams":null,"needsRuntimeRequest":"$@20"}
